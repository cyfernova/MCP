# MCP Server Configuration

# Server Configuration
MCP_LISTEN_ADDR=:9090

# TLS Configuration (mTLS) - REQUIRED
# Generate certificates with: openssl req -x509 -newkey rsa:4096 -keyout server.key -out server.crt -days 365 -nodes
# Generate CA: openssl req -x509 -newkey rsa:4096 -keyout ca.key -out ca.crt -days 365 -nodes -subj "/CN=My CA"
MCP_TLS_CERT_FILE=./certs/server.crt
MCP_TLS_KEY_FILE=./certs/server.key
MCP_TLS_CA_FILE=./certs/ca.crt

# Backend Configuration
BACKEND_BASE_URL=https://2msvdt2oba.execute-api.us-east-1.amazonaws.com/

# Authentication Configuration (JWT)
AUTH_JWKS_URL=https://2msvdt2oba.execute-api.us-east-1.amazonaws.com/.well-known/jwks.json
AUTH_ISSUER=your-backend
AUTH_AUDIENCE=mcp

# Rate Limiting
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10

# Logging
LOG_LEVEL=info
